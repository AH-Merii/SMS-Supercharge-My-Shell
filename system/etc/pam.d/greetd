#%PAM-1.0
# The greetd package's stock stack plus gnome-keyring, so the login password unlocks
# ~/.local/share/keyrings/login.keyring the way it did under sddm.
# Installed by `mise run greeter`; the greetd package's copy becomes a .pacnew on upgrades.

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
-auth      optional     pam_gnome_keyring.so

account    include      system-local-login

password   include      system-local-login
-password  optional     pam_gnome_keyring.so    use_authtok

session    include      system-local-login
# Redundant but harmless: system-local-login -> system-login already runs pam_systemd
# (as `-session optional`). Kept because noctalia-greeter's setup_greetd_pam.sh greps
# this file for the literal `pam_systemd.so` and inserts exactly this line when absent;
# dropping it would just make the file drift from what that script converges on.
session    required     pam_systemd.so
-session   optional     pam_gnome_keyring.so    auto_start
