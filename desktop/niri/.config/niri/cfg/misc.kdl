    prefer-no-csd
    screenshot-path null

    environment {
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        QT_QPA_PLATFORM "wayland;xcb"
        QT_QPA_PLATFORMTHEME "gtk3"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    }

    cursor {
        xcursor-theme "phinger-cursors-dark"
        xcursor-size 48
    }

    // Weakens focus-stealing protection: any client can activate a window without a
    // valid xdg-activation token. Kept because Noctalia relies on it for notification
    // actions and window activation; drop it if Noctalia ever passes proper tokens.
    debug {
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }
