#!/usr/bin/env bash
#MISE description="Set a machine up, one question: activate, then pacman, aur, greeter and memory where they apply (same flags as activate)"
#MISE raw=true
#
# One plan for every step that applies to this configuration, one question, then the steps
# run with SMS_PLAN_CONFIRMED=1, which skips their own previews and prompts: everything they
# would have asked about is already on screen above. The greeter is the exception by design:
# it writes root's files and asks for the password itself, whatever was answered here and
# whatever pacman's sudo left cached.
#
# Which steps apply is the configuration's to say, not the machine's: pacman and aur on Linux
# where pacman exists, the greeter on the Linux Desktop, memory everywhere.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=lib/activate.sh
source lib/activate.sh
# shellcheck source=lib/distro.sh
source lib/distro.sh
# shellcheck source=lib/plan.sh
source lib/plan.sh

# Captured task output would swallow the prompt and hang the run.
unset MISE_TASK_OUTPUT

sms_configuration "$@"

distro=0 greeter=0
if [[ $platform == linux ]] && sms_distro_here; then distro=1; fi
if [[ $tier == desktop && $distro == 1 ]]; then greeter=1; fi
# plan_greeter and the greeter task read the stow-era profile; the tier is what says whether
# the login screen belongs here, so the profile is told rather than detected.
export DOTFILES_PROFILE=base
if [[ $tier == desktop ]]; then DOTFILES_PROFILE=desktop; fi
profile=$DOTFILES_PROFILE

sms_build
sms_activate_scan
[[ $distro == 0 ]] || sms_distro_lists

sms_header "set up as $configuration"
sms_activate_show
[[ $distro == 0 ]] || sms_distro_show
[[ $greeter == 0 ]] || plan_greeter
plan_memory

if ! sms_confirm 'Set up?'; then
  # Exit 0: declining is an answer, not a failure.
  printf '\n  aborted, nothing changed\n\n'
  exit 0
fi

# One password prompt at a predictable moment rather than partway through pacman, which
# asks again itself if this one was declined or mistyped; said, so the lecture pacman then
# prints is not the first sign that this one went unanswered.
if [[ $distro == 1 && $(( ${#pacman_want[@]} + ${#aur_want[@]} )) -gt 0 ]] && ! sms_sudo_v; then
  sms_warn 'sudo not authenticated here; pacman asks itself'
fi

export SMS_PLAN_CONFIRMED=1

sms_header '==> activate'
sms_activate_run

if [[ $distro == 1 ]]; then
  sms_header '==> pacman'
  sms_distro_install_pacman
  if [[ ${#aur_all[@]} -gt 0 ]]; then
    sms_header '==> aur'
    sms_distro_install_aur
  fi
fi

# Sequential `mise run`s: the greeter needs pacman's packages in place, and memory links into
# a directory named after this checkout, which the activation may just have created.
#
# The greeter is the one step that can stop for want of a password (no terminal, none
# given); memory does not depend on it, so it runs regardless and the failure is carried
# to the end, where it is the exit status.
greeter_status=0
if [[ $greeter == 1 ]]; then
  sms_header '==> greeter'
  mise run greeter || greeter_status=$?
fi
sms_header '==> memory'
mise run memory

if [[ $greeter_status -eq 0 ]]; then
  printf '\n  %sset up as %s%s\n' "$c_bold$c_green" "$configuration" "$c_reset"
else
  printf '\n  %sset up as %s, except the login screen%s\n' "$c_bold$c_yellow" "$configuration" "$c_reset"
  sms_err "the greeter step failed (exit $greeter_status); run \`mise run greeter\` from a terminal"
fi

# What still needs you, printed here rather than in bootstrap.sh so it lands however setup
# was reached, and never after a declined plan.
#
# The path, not the name: a distro may ship fish as the login shell already (CachyOS does),
# and that is the distro's fish, not the profile's, which is the one the configuration wants.
if [[ ${SHELL:-} != "$HOME/.nix-profile/bin/fish" ]]; then
  # shellcheck disable=SC2016  # literal text for the user to copy, not to expand here
  sms_note 'make fish the login shell:  echo "$HOME/.nix-profile/bin/fish" | sudo tee -a /etc/shells; chsh -s "$HOME/.nix-profile/bin/fish"'
fi
# The tasks are the checkout's, so `mise run` finds them from inside it only.
sms_note 'then, from fish in this checkout:  mise run plugins  (fish and tmux plugins)  and  ggh  (git identity and signing)'
[[ $greeter == 0 ]] || sms_note 'reboot to log in through the greeter'
echo
exit "$greeter_status"
