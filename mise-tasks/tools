#!/usr/bin/env bash
#MISE description="Install every tool in the global mise config, and re-fetch its nightlies"
#MISE raw=true
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=lib/plan.sh
source lib/plan.sh

sms_preview plan_tools 'Install these tools?' || exit 0

# Before the plain install, so a fresh machine downloads each nightly once.
mapfile -t nightly < <(nightly_tools)
[[ ${#nightly[@]} -eq 0 ]] || mise install --yes --force "${nightly[@]}"

# --yes unconditionally: by this line the install is confirmed either way, and mise's own
# prompt is about trusting config files the plan has already accounted for.
mise install --yes
