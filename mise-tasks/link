#!/usr/bin/env bash
#MISE description="Stow the layers for this machine's profile (check previews it)"
#MISE raw=true
#
# Idempotent: `stow -R` restows, and anything already sitting where a link belongs
# (a real file, or a symlink stow does not own) is moved to <path>.bak first, so a
# fresh machine, a re-run, and a layout change all converge without manual steps.
#
# No dry-run mode: `check` renders the same plan_links preview and stops there.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=mise-tasks/profile
source mise-tasks/profile
# shellcheck source=lib/plan.sh
source lib/plan.sh

target=$HOME
if [[ $PWD == */.claude/worktrees/* ]]; then
  sms_err "refusing to link from a worktree ($PWD); run from the main checkout"
  exit 1
fi

# Move whatever stow would refuse to overwrite out of the way. What counts as a conflict
# is stow_conflicts (lib/plan.sh), shared with the preview so the two cannot disagree.
backup_conflicts() {
  local rel path bak
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    path="$target/$rel" bak="$target/$rel.bak"
    [[ -e $path || -L $path ]] || continue
    if [[ -e $bak || -L $bak ]]; then
      bak="$bak.$(date +%Y%m%d%H%M%S)"
    fi
    mv "$path" "$bak"
    sms_note "backed up $rel -> ${bak#"$target/"}"
  done < <(stow_conflicts "$@")
}

sms_preview plan_links 'Link these packages?' || exit 0

for layer in "${layers[@]}"; do
  mapfile -t lpkgs < <(layer_pkgs "$layer")
  backup_conflicts "$layer" "${lpkgs[@]}"
  # .stowrc supplies --target and --no-folding
  stow -d "$layer" -R "${lpkgs[@]}"
done

if [[ " ${layers[*]} " == *" desktop "* ]]; then
  # niri includes noctalia.kdl, which Noctalia generates on first run
  mkdir -p "$target/.config/niri"
  touch "$target/.config/niri/noctalia.kdl"
  # pick up a relinked settings.toml without a re-login
  if command -v noctalia >/dev/null 2>&1 && pgrep -x noctalia >/dev/null 2>&1; then
    noctalia msg config-reload >/dev/null 2>&1 || true
  fi
fi
