#!/usr/bin/env bash
#MISE description="Stow the layers for this machine's profile (STOW_FLAGS=-n to dry-run)"
#MISE raw=true
#
# Idempotent: `stow -R` restows, and anything already sitting where a link belongs
# (a real file, or a symlink stow does not own) is moved to <path>.bak first, so a
# fresh machine, a re-run, and a layout change all converge without manual steps.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=mise-tasks/profile
source mise-tasks/profile
# shellcheck source=lib/plan.sh
source lib/plan.sh

flags=${STOW_FLAGS:-}
target=$HOME
if [[ -z $flags && $PWD == */.claude/worktrees/* ]]; then
  sms_err "refusing to link from a worktree ($PWD); run from the main checkout"
  exit 1
fi

# Move whatever stow would refuse to overwrite out of the way. What counts as a conflict
# is stow_conflicts (lib/plan.sh), shared with the preview so the two cannot disagree.
backup_conflicts() {
  local rel path bak
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    path="$target/$rel" bak="$target/$rel.bak"
    [[ -e $path || -L $path ]] || continue
    if [[ -e $bak || -L $bak ]]; then
      bak="$bak.$(date +%Y%m%d%H%M%S)"
    fi
    mv "$path" "$bak"
    sms_note "backed up $rel -> ${bak#"$target/"}"
  done < <(stow_conflicts "$@")
}

# base/nvim links ~/.config/nvim into this submodule; --remote moves it to nvim-config's latest main.
update_nvim_config() {
  git submodule update --init --remote nvim-config 2>/dev/null && return 0
  # lazy.nvim rewrites lazy-lock.json in place, and git will not check out over that edit
  local lock=nvim-config/nvim/lazy-lock.json bak
  if [[ -e nvim-config/.git ]] && ! git -C nvim-config diff --quiet -- nvim/lazy-lock.json; then
    bak=$lock.bak
    [[ -e $bak ]] && bak="$bak.$(date +%Y%m%d%H%M%S)"
    cp "$lock" "$bak"
    git -C nvim-config checkout -q -- nvim/lazy-lock.json
    sms_note "backed up $lock -> $bak (lazy.nvim's edit), so nvim-config's can be checked out"
  fi
  git submodule update --init --remote nvim-config
}

# A dry run is already a preview, so asking first would be a question about nothing.
if [[ -n $flags ]]; then
  plan_links
else
  sms_preview plan_links 'Link these packages?' || exit 0
fi

if [[ -z $flags ]] && ! update_nvim_config; then
  sms_warn 'nvim-config was not updated (git says why above); linking the checkout already there'
fi

for layer in "${layers[@]}"; do
  mapfile -t lpkgs < <(layer_pkgs "$layer")
  [[ -n $flags ]] || backup_conflicts "$layer" "${lpkgs[@]}"
  # .stowrc supplies --target and --no-folding
  # shellcheck disable=SC2086
  stow $flags -d "$layer" -R "${lpkgs[@]}"
done

# bat only sees the custom theme (base/bat) through its cache; mise also rebuilds it on upgrade
if [[ -z $flags ]] && command -v bat >/dev/null 2>&1; then
  bat cache --build >/dev/null
fi

if [[ -z $flags && " ${layers[*]} " == *" desktop "* ]]; then
  # niri includes noctalia.kdl, which Noctalia generates on first run
  mkdir -p "$target/.config/niri"
  touch "$target/.config/niri/noctalia.kdl"
  # pick up a relinked settings.toml without a re-login
  if command -v noctalia >/dev/null 2>&1 && pgrep -x noctalia >/dev/null 2>&1; then
    noctalia msg config-reload >/dev/null 2>&1 || true
  fi
fi
