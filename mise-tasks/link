#!/usr/bin/env bash
#MISE description="Stow the layers for this machine's profile (STOW_FLAGS=-n to dry-run)"
#
# Idempotent: `stow -R` restows, and anything already sitting where a link belongs
# (a real file, or a symlink stow does not own) is moved to <path>.bak first, so a
# fresh machine, a re-run, and a layout change all converge without manual steps.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=mise-tasks/profile
source mise-tasks/profile

flags=${STOW_FLAGS:-}
target=$HOME
if [[ -z $flags && $PWD == */.claude/worktrees/* ]]; then
  echo "refusing to link from a worktree ($PWD); run from the main checkout" >&2
  exit 1
fi

# Move whatever stow would refuse to overwrite out of the way.
backup_conflicts() {
  local layer=$1
  shift
  local out rel
  out=$(stow -n -d "$layer" -R "$@" 2>&1 || true)
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    local path="$target/$rel" bak="$target/$rel.bak"
    [[ -e $path || -L $path ]] || continue
    if [[ -e $bak || -L $bak ]]; then
      bak="$bak.$(date +%Y%m%d%H%M%S)"
    fi
    if [[ -n $flags ]]; then
      echo "would back up $rel -> ${bak#"$target/"}"
    else
      mv "$path" "$bak"
      echo "backed up $rel -> ${bak#"$target/"}"
    fi
  done < <(printf '%s\n' "$out" | sed -nE \
    -e 's/^ *\* existing target is not owned by stow: (.*)$/\1/p' \
    -e 's/^ *\* cannot stow .* over existing target (.*) since neither a link nor a directory.*$/\1/p')
}

echo "profile: $profile"
for layer in "${layers[@]}"; do
  mapfile -t pkgs < <(ls -1 "$layer")
  echo "$layer: ${pkgs[*]}"
  backup_conflicts "$layer" "${pkgs[@]}"
  # .stowrc supplies --target and --no-folding
  # shellcheck disable=SC2086
  stow $flags -d "$layer" -R "${pkgs[@]}"
done

if [[ -z $flags && " ${layers[*]} " == *" desktop "* ]]; then
  # niri includes noctalia.kdl, which Noctalia generates on first run
  mkdir -p "$target/.config/niri"
  touch "$target/.config/niri/noctalia.kdl"
  # pick up a relinked settings.toml without a re-login
  if command -v noctalia >/dev/null 2>&1 && pgrep -x noctalia >/dev/null 2>&1; then
    noctalia msg config-reload >/dev/null 2>&1 || true
  fi
fi
