#!/usr/bin/env bash
#MISE description="Build, preview and switch to one configuration: --tier shell|desktop [--platform linux|darwin|wsl]"
#MISE raw=true
#
# Build, then a preview of what the switch will do to this home, one question, and
# home-manager's own activation with backups on. The preview and the activation are
# lib/switch.sh, shared with setup, which shows the preview in its combined plan and asks its
# one question; the preview is then not shown again here.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=lib/switch.sh
source lib/switch.sh

sms_configuration "$@"
sms_build
sms_switch_scan

if ! sms_preview sms_switch_show 'Switch?'; then
  # Exit 0: declining is an answer, not a failure.
  printf '\n  aborted, nothing changed\n\n'
  exit 0
fi

sms_switch_activate
