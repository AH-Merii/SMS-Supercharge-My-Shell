#!/usr/bin/env bash
#MISE description="Install the pacman list of one configuration: --tier shell|desktop"
#MISE raw=true
#
# The derived pacman list of a configuration, previewed, one question, then the install.
# Nothing the distro installed is ever removed.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# shellcheck source=lib/distro.sh
source lib/distro.sh

sms_configuration "$@"
if [[ $platform != linux ]] || ! sms_distro_here; then
  sms_note "no pacman for $configuration on this machine; nothing to install here"
  exit 0
fi
sms_distro_lists
sms_header "pacman for $configuration"

if ! sms_preview sms_distro_show_pacman 'Install these?'; then
  # Exit 0: declining is an answer, not a failure.
  printf '\n  aborted, nothing installed\n\n'
  exit 0
fi

sms_distro_install_pacman
