#!/usr/bin/env bash
#MISE description="Print the detected profile (override with DOTFILES_PROFILE=base|desktop|macos)"
#
# Also sourced by the other tasks, which use $profile and $layers.
#   base     any Linux without a desktop: servers, WSL
#   desktop  Linux with niri
#   macos    macOS
set -euo pipefail

# Same test bootstrap.sh uses, so the two never disagree about what WSL is.
is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

detect_profile() {
  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    echo "$DOTFILES_PROFILE"
    return
  fi
  case "$(uname -s)" in
    Darwin) echo macos ;;
    Linux)
      if is_wsl; then
        echo base
      elif command -v niri >/dev/null 2>&1 || [[ -n ${NIRI_SOCKET:-} ]] || [[ -f /usr/share/wayland-sessions/niri.desktop ]]; then
        echo desktop
      else
        echo base
      fi
      ;;
    *) echo base ;;
  esac
}

profile=$(detect_profile)

# Whether the Brewfile applies here: macOS, or WSL (base profile). Arch and servers get
# their packages from pkglist/, and a linuxbrew that happens to be on PATH must not pull
# in a second git, gnupg and so on in front of pacman's (README, "Package sources").
# Gated on the profile rather than on `command -v brew`, so DOTFILES_PROFILE overrides
# answer the same way autodetection would.
use_brew() { [[ $profile == macos ]] || { [[ $profile == base ]] && is_wsl; }; }

# shellcheck disable=SC2034  # layers is consumed by the tasks that source this file
case "$profile" in
  base) layers=(base) ;;
  desktop) layers=(base desktop) ;;
  macos) layers=(base macos) ;;
  *)
    echo "unknown profile: $profile (expected base, desktop or macos)" >&2
    exit 1
    ;;
esac

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  echo "$profile"
fi
