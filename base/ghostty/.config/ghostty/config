# Use main branch builds instead of stable releases
auto-update-channel = tip

theme = Atom One Dark
font-size = 16
mouse-hide-while-typing = true
#window-decoration = none
#font-family = "FiraCode Nerd Font Mono"
#font-family = "Rec Mono Duotone"
#font-family = "FiraCode Nerd Font"
# Font features
#font-feature = dlig
#font-feature = ss01
#font-feature = ss03
#font-feature = ss06
#font-feature = ss08
#font-feature = ss12
#font-feature = liga
#font-feature = calt
font-family = "FiraCode Nerd Font"
clipboard-trim-trailing-spaces = true
link-url = true
cursor-style-blink = true

copy-on-select = clipboard

# Desktop notifications via OSC 9/777 (used by Claude Code hooks)
desktop-notifications = true

# Disabled while chasing input latency: opacity < 1 forfeits the opaque-region
# fast path, so the compositor alpha-blends the whole 4K surface every frame.
# background-blur is a no-op on niri anyway (KDE blur protocol, unimplemented).
#background-opacity = 0.95
#background-blur = 20

# Custom Shaders
# https://catskull.net/fun-with-ghostty-shaders.html
# Disabled: any custom shader forces a continuous render loop at display
# refresh (custom-shader-animation defaults to true), and cursor_sweep is a
# spring-damped trail that takes ~200ms to settle after every keystroke, which
# reads as typing lag.
#custom-shader = shaders/cursor_sweep.glsl
#custom-shader = shaders/sonic_boom_cursor.glsl
# nice light theme uncomment below
#custom-shader = shaders/negative.glsl

# Keybinds
keybind = ctrl+arrow_down=jump_to_prompt:1
keybind = ctrl+arrow_up=jump_to_prompt:-1
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = shift+enter=text:\x1b\r

# Ctrl+Backspace has no encoding in the legacy key protocol: Backspace is the
# control character 0x7f, and only CSI keys (arrows, F-keys, Delete) carry a
# modifier field. The Kitty protocol does encode it (CSI 127;5u), but apps that
# don't negotiate it -- Claude Code, plain ssh -- never see the key at all.
# Alt+Backspace has a universal encoding (ESC + the key's bytes), so send that
# instead and every app gets a working delete-previous-word.
keybind = ctrl+backspace=text:\x1b\x7f

quit-after-last-window-closed = true
