# Use main branch builds instead of stable releases
auto-update-channel = tip

theme = OneDark
font-size = 16
mouse-hide-while-typing = true
#window-decoration = none
#font-family = "FiraCode Nerd Font Mono"
#font-family = "Rec Mono Duotone"
#font-family = "FiraCode Nerd Font"
# Font features
#font-feature = dlig
#font-feature = ss01
#font-feature = ss03
#font-feature = ss06
#font-feature = ss08
#font-feature = ss12
#font-feature = liga
#font-feature = calt
font-family = "FiraCode Nerd Font"
# Fira Code has no italic face, so italics (comments, autosuggestions) borrow
# Cascadia's cursive. Nerd Font glyphs in italic runs fall back to Fira Code.
font-family-italic = "CaskaydiaCove Nerd Font"
font-family-bold-italic = "CaskaydiaCove Nerd Font"
clipboard-trim-trailing-spaces = true
link-url = true
cursor-style-blink = true

copy-on-select = clipboard

# Desktop notifications via OSC 9/777 (used by Claude Code hooks)
desktop-notifications = true

# Disabled while chasing input latency: opacity < 1 forfeits the opaque-region
# fast path, so the compositor alpha-blends the whole 4K surface every frame.
# background-blur is a no-op on niri anyway (KDE blur protocol, unimplemented).
#background-opacity = 0.95
#background-blur = 20

# Custom Shaders
# https://catskull.net/fun-with-ghostty-shaders.html
# Disabled: any custom shader forces a continuous render loop at display
# refresh (custom-shader-animation defaults to true), and cursor_sweep is a
# spring-damped trail that takes ~200ms to settle after every keystroke, which
# reads as typing lag.
#custom-shader = shaders/cursor_sweep.glsl
#custom-shader = shaders/sonic_boom_cursor.glsl
# nice light theme uncomment below
#custom-shader = shaders/negative.glsl

# Keybinds
keybind = ctrl+arrow_down=jump_to_prompt:1
keybind = ctrl+arrow_up=jump_to_prompt:-1
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = shift+enter=text:\x1b\r
keybind = ctrl+enter=unbind

# Ctrl+Backspace has no encoding in the legacy key protocol: Backspace is the
# control character 0x7f, and only CSI keys (arrows, F-keys, Delete) carry a
# modifier field. The Kitty protocol does encode it (CSI 127;5u), but apps that
# don't negotiate it -- Claude Code, plain ssh -- never see the key at all.
# Alt+Backspace has a universal encoding (ESC + the key's bytes), so send that
# instead and every app gets a working delete-previous-word.
keybind = ctrl+backspace=text:\x1b\x7f

# Scroll mode: ctrl+s, then vim keys scroll the scrollback; q or Esc leaves.
# v and V open the visible screen or all of it in nvim, for vim selection and
# yanks. Ghostty can't tell fish to do that, so they send a key fish binds
# (fish/conf.d/23-screen-nvim.fish), then the path of a dump and Enter. They
# only work at a fish prompt.
keybind = ctrl+s=activate_key_table:scroll
keybind = scroll/catch_all=ignore
keybind = scroll/q=deactivate_key_table
keybind = scroll/escape=deactivate_key_table
keybind = scroll/ctrl+u=scroll_page_fractional:-0.5
keybind = scroll/ctrl+d=scroll_page_fractional:0.5
keybind = scroll/g>g=scroll_to_top
keybind = scroll/shift+g=scroll_to_bottom
keybind = scroll/v=deactivate_key_table
keybind = chain=scroll_to_bottom
keybind = chain=csi:23;8~
keybind = chain=write_screen_file:paste
keybind = chain=text:\r
keybind = scroll/shift+v=deactivate_key_table
keybind = chain=scroll_to_bottom
keybind = chain=csi:24;8~
keybind = chain=write_screen_file:paste
keybind = chain=text:\r

quit-after-last-window-closed = true
